# Copy to .env and fill in for your environment.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set DB_ENGINE=postgres to use PostgreSQL instead of the SQLite dev default
DB_ENGINE=sqlite
DB_NAME=bestiebooks
DB_USER=bestiebooks
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# MTN MoMo Developer Portal sandbox credentials (https://momodeveloper.mtn.com)
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CALLBACK_URL=

# Airtel Money (Openweb Collections API sandbox: https://developers.airtel.africa)
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=RW
AIRTEL_CURRENCY=RWF

# Flutterwave Standard (https://developer.flutterwave.com)
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FRONTEND_URL=http://localhost:3000
